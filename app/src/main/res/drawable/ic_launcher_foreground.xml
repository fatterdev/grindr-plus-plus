<?xml version="1.0" encoding="utf-8"?>
<!-- GrindMod: same 108dp foreground as Grindr++ (face inside safe zone) + gear badge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/ic_brand_foreground"
        android:gravity="fill" />
